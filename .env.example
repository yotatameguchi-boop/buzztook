# --- 必須 ---

# PostgreSQL 接続URL。未設定の場合は .data/buzztook.json のローカルストアで動作します（開発専用）。
DATABASE_URL="postgresql://user:password@localhost:5432/buzztook?schema=public"

# セッション署名用のシークレット。次のコマンドで生成してください:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# --- 任意 ---

# 招待コード。設定すると新規登録時に必須になります（クローズドデモ運用向け）。
# 空または未設定なら誰でも登録できます。
INVITE_CODE=""

# 本番デプロイ時、Auth.js がコールバックURLを解決するために使います（Vercelでは自動設定）。
# AUTH_URL="https://your-domain.example.com"

# TODO(Phase 2): FastAPI の分析サービスに切り替える場合のエンドポイント
# ANALYSIS_SERVICE_URL="http://localhost:8000"

# TODO(Phase 4): TikTok API 連携（規約・審査の確認後に有効化する）
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
